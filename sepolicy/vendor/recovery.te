recovery_only(`
    allow recovery sysfs:dir r_dir_perms;
    allow recovery sysfs:lnk_file r_file_perms;

    r_dir_file(recovery, sysfs_batteryinfo)
    r_dir_file(recovery, vendor_sysfs_battery_supply)
    r_dir_file(recovery, vendor_sysfs_qcom_battery)
    r_dir_file(recovery, vendor_sysfs_usb_supply)

    allow fastbootd sysfs:dir r_dir_perms;
    r_dir_file(fastbootd, sysfs_batteryinfo)
    r_dir_file(fastbootd, vendor_sysfs_battery_supply)
    r_dir_file(fastbootd, vendor_sysfs_qcom_battery)
    r_dir_file(fastbootd, vendor_sysfs_usb_supply)
')
